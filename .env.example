# 复制本文件为 .env.local 并填入真实 key（.env.local 已被 .gitignore 忽略，不会进 git）。
# 改动 .env.local 后需重启 npx expo start 才生效（Metro 打包时内联）。
# 注意：EXPO_PUBLIC_ 变量会打进客户端包——仅限试装自测；分发包不带 key、由登录后的服务端代理供给（见 DECISIONS D-004/D-010/D-057）。
# 引擎与 key **只从这里读**（D-069）：设置页的手填与脚本引擎（mock）已下线；本地没 key 且未登录时，聊天会直接显示「未配置 AI」。

# Claude（https://console.anthropic.com/settings/keys）
EXPO_PUBLIC_ANTHROPIC_API_KEY=

# 百度千帆（https://console.bce.baidu.com/qianfan/ → API Key）
EXPO_PUBLIC_QIANFAN_API_KEY=

# 千帆上用哪个模型，默认 deepseek-v4-pro；以千帆模型广场上的模型 ID 为准
# EXPO_PUBLIC_QIANFAN_MODEL=deepseek-v4-pro

# 用哪家引擎（D-069）：anthropic | qianfan。不填则有 Claude key 用 Claude，否则千帆（服务端代理两家都通）。
# EXPO_PUBLIC_AI_ENGINE=qianfan

# 图像生成（立绘 / 外出拍照）与聊天共用上面的千帆 key，无需单独配置。
# 文生图模型，默认 qwen-image；以千帆模型广场为准
# EXPO_PUBLIC_QIANFAN_IMAGE_MODEL=qwen-image

# 语音合成（TA 的语音气泡，D-048）同样共用千帆 key。
# 模型默认 qwen-tts；音色默认按角色人称选（他 Ethan / 她 Cherry / TA Serena），可全局覆盖
# EXPO_PUBLIC_QIANFAN_TTS_MODEL=qwen-tts
# EXPO_PUBLIC_QIANFAN_TTS_VOICE=Cherry

# 账号与云备份（D-054）：Supabase 项目设置 → API 里的 Project URL 与 anon public key。
# 建表 SQL 见 docs/supabase-setup.sql；不配置时账号功能隐藏、其他一切照旧。
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
