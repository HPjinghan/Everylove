{
  "expo": {
    "name": "全自动恋爱",
    "slug": "everylove",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "everylove",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kotoko.everylove",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6F4"
        }
      ],
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "用来录语音消息和打电话给 TA。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用来在会话里发送你的位置；不授权也可以在地图上自己选。",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false
        }
      ],
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "用来上传头像和把照片发给 TA。",
          "cameraPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "299908ab-dbbb-41aa-865f-5fd85152b9d1"
      }
    },
    "owner": "harperzs-team",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/299908ab-dbbb-41aa-865f-5fd85152b9d1"
    }
  }
}
